    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="13"
                android:startY="0"
                android:endX="95"
                android:endY="108">
                <item android:offset="0" android:color="#F7DE86" />
                <item android:offset="0.5" android:color="#D4AF37" />
                <item android:offset="1" android:color="#A9812A" />
            </gradient>
